# KoiLiSu 通用 .gitignore

# IDE 和編輯器
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# 作業系統
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# PHP
*.log
*.tmp
/vendor/*
!/vendor/libheif/
composer.phar
composer.lock

# 設定檔案（如包含敏感資訊）
config.local.php
.env

# 快取和暫存檔案
cache/
temp/
tmp/

# 備份檔案
*.bak
*.backup
*~

# 部署相關
deploy.php

# 測試檔案
phpunit.xml
/tests/coverage/

# Node.js（如果使用）
node_modules/
npm-debug.log
yarn-error.log

# Claude Code 背景 agent 的獨立 worktree（內含自己的 .git，不進版本紀錄）
.claude/

# 本機機密與開發產物（字型授權、固定 vendor 與測試程式仍應版控）
.env.*
!.env.example
!.env.sample
*.local.php
.claude/
.codex/
__pycache__/
*.py[cod]
*.swp
*.orig
*.key
*.pem
*.p12
*.pfx
/secrets/
